# Copy to .env and adjust.
# Postgres / Timescale
POSTGRES_PASSWORD=change-me-db

# API
API_TOKEN=change-me-token
API_PORT=8099

# Meter source(s): comma-separated hosts running the ESPHome native API.
# Add the smart plug's host here later, e.g. 192.168.178.213,192.168.178.240
METER_HOSTS=192.168.178.213
METER_PORT=6053
# ESPHome api encryption key (leave empty: this meter has none)
METER_NOISE_PSK=

# Detection
EVENT_THRESHOLD_W=80
EVENT_MIN_DURATION_S=3
EVENT_CLOSE_BAND_W=40
EVENT_CLOSE_HOLD_S=3
EVENT_MAX_S=14400
